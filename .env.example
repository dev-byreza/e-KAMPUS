# Supabase PostgreSQL — Session/Transaction Pooler URL
# Get from: Supabase Dashboard → Settings → Database → Connection string → Session/Transaction pooler
DATABASE_URL=postgresql://postgres.[project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres

# Supabase Storage (untuk upload PDF mahasiswa & sinkronisasi lintas perangkat)
# Get from: Supabase Dashboard → Settings → API → Project URL & anon public key
VITE_SUPABASE_URL=https://[project-ref].supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
